# Normalización de finales de línea para archivos de texto
* text=auto

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Artefactos binarios: Git no debe intentar mostrar diferencias de texto
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.pptx binary
*.docx binary
*.zip binary
